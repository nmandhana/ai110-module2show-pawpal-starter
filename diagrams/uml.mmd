classDiagram
    %% PawPal+ initial design (draft)
    %% Data classes: Owner, Pet, Task
    %% Logic: Scheduler (stateless)
    %% Result: DailyPlan made of ScheduledTask entries

    class Owner {
        +str name
        +int available_minutes
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
    }

    class Scheduler {
        +build_plan(owner, pet) DailyPlan
        -rank_tasks(tasks) list~Task~
        -fits_in_budget(task, minutes_left) bool
    }

    class ScheduledTask {
        +Task task
        +str start_time
        +str reason
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class DailyPlan {
        +list~ScheduledTask~ entries
        +list~SkippedTask~ skipped
        +explain() str
    }

    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads constraints
    Scheduler ..> Pet : reads tasks
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" --> "0..*" ScheduledTask : contains
    DailyPlan "1" --> "0..*" SkippedTask : left out
    ScheduledTask --> Task : schedules
    SkippedTask --> Task : refers to
