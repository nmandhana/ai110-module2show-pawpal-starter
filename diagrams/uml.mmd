classDiagram
    %% PawPal+ design
    %% Data classes: Task, Pet, Owner (Owner manages multiple pets)
    %% Logic: Scheduler (stateless, reads tasks via Owner.get_all_tasks)
    %% Result: DailyPlan made of ScheduledTask entries + SkippedTask leftovers

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +str pet_name
        +mark_complete() None
    }

    class Scheduler {
        +build_plan(owner) DailyPlan
        -rank_tasks(tasks) list~Task~
        -fits_in_budget(task, minutes_left) bool
    }

    class ScheduledTask {
        +Task task
        +str start_time
        +str reason
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class DailyPlan {
        +list~ScheduledTask~ entries
        +list~SkippedTask~ skipped
        +explain() str
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads constraints + get_all_tasks()
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" --> "0..*" ScheduledTask : contains
    DailyPlan "1" --> "0..*" SkippedTask : left out
    ScheduledTask --> Task : schedules
    SkippedTask --> Task : refers to
